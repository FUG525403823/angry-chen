# S15 §3/§5：只转发 HTTP 面（/health、/metrics、/api/*）。
# 客户端是原生进程：本文件只做转发，不含任何静态资源托管指令（§6-4 的字符串校验点为 0）。
{
	admin off
}

:80 {
	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8787
	}
	handle /health {
		reverse_proxy 127.0.0.1:8787
	}
	handle /metrics {
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		respond 404
	}
	header Cache-Control "no-store"
}
