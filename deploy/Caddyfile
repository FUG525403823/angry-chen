# ============================================================================
# Caddy 反代样例：客户端静态资源 + 游戏 WebSocket(WSS)（ADR-004 §1）
#
# 验证状态：静态审查（本机无 docker、无 caddy，此文件从未被 caddy validate/run 过）。
# 人类必须验证的点：
#   1) 语法：`caddy validate --config deploy/Caddyfile --adapter caddyfile`
#   2) WSS 握手：浏览器打开 https://<域名>/?server=wss://<域名>/ws，应能进房
#      （反代返回 101；Caddy 的 reverse_proxy 自动透传 Upgrade/Connection）
#   3) 缓存头：`curl -sI https://<域名>/assets/<hash>.js` 应含
#      `Cache-Control: public, max-age=31536000, immutable`
#   4) 探针：`curl -s https://<域名>/health` 返回 {"status":"ok",...}，
#      `/metrics` 与 `/api/*` 不被静态兜底吃掉
#   5) 若 SITE_ADDRESS 换成真实域名：Caddy 会自动申请 TLS 证书，需 80/443 可达
#
# 变量：SITE_ADDRESS（默认 localhost → 仅 HTTP:80）、GAME_UPSTREAM（默认 127.0.0.1:8787）、
#       CLIENT_ROOT（默认 /srv/client）。
# 本机自签实测（可选）：把站点地址写成 `https://localhost:8443` 并在站点块内加 `tls internal`。
# ============================================================================

{$SITE_ADDRESS:localhost} {
	encode zstd gzip
	root * {$CLIENT_ROOT:/srv/client}

	# 游戏 WebSocket。客户端默认连 ws://127.0.0.1:8787，公网需显式指定：
	#   https://<域名>/?server=wss://<域名>/ws
	# （服务端接受任意路径的 upgrade，见 packages/server/src/transport/ws-adapter.ts）
	handle /ws {
		reverse_proxy {$GAME_UPSTREAM:127.0.0.1:8787}
	}

	# 健康检查与指标：不能缓存，直接转发到 Node 进程
	handle /health {
		reverse_proxy {$GAME_UPSTREAM:127.0.0.1:8787}
	}
	handle /metrics {
		reverse_proxy {$GAME_UPSTREAM:127.0.0.1:8787}
	}

	# 排行榜与最近对局（packages/server/src/http.ts 的 /api/leaderboard、/api/matches/recent）
	handle /api/* {
		reverse_proxy {$GAME_UPSTREAM:127.0.0.1:8787}
	}

	# 带内容 hash 的构建产物：一年不可变缓存
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 其余走 SPA 兜底；index.html 不缓存，保证发版后立刻拿到新 hash
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
