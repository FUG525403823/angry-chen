# 仅反代 HTTP；游戏 UDP 8788 仍由客户端直连。
# 后端设置 AC_HTTP_BIND=127.0.0.1、AC_TRUST_LOOPBACK_PROXY=1。
# 修改默认后端端口时，也须向 Caddy 进程注入 AC_HTTP_PORT。
{
	admin off
}

:80 {
	@operations {
		path /health /metrics
		remote_ip 127.0.0.1 ::1
	}
	handle @operations {
		reverse_proxy 127.0.0.1:{$AC_HTTP_PORT:8787} {
			header_up X-Real-IP {remote_host}
			header_up -X-Forwarded-For
			header_up -Forwarded
		}
	}
	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:{$AC_HTTP_PORT:8787} {
			header_up X-Real-IP {remote_host}
			header_up -X-Forwarded-For
			header_up -Forwarded
		}
	}
	handle {
		respond 404
	}
	header Cache-Control "no-store"
}
