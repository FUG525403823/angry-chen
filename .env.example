# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，仓库不提交任何密钥（本项目目前没有密钥）。
#
# 变量全集来自 ADR-004（docs/00-共识/ADR/ADR-004-部署与持久化形态.md）。
# 注意：服务端进程直接读 process.env，仓库里 **没有** 任何 dotenv 依赖，也不会自动加载 .env。
# 让 .env 生效的三种方式（实测命令见 docs/运维手册.md §7）：
#   1) 本机开发：set -a && . ./.env && set +a && pnpm dev
#   2) tsx 直跑：pnpm --filter @ac/server exec tsx --env-file=.env src/main.ts
#   3) 守护进程：systemd 用 EnvironmentFile=，PM2 用 ecosystem.config.cjs 的 env 块

# ---- 监听（读取位置：packages/server/src/main.ts，PORT/HOST）----
# 游戏服务端口；单进程同时承载 HTTP 与 WebSocket（ADR-004 §1）。
PORT=8787
# 注意：8080 常被本机其它软件占用；冲突时改 PORT，或临时 PORT=9000。
# 绑定地址：本机开发用 127.0.0.1，反向代理后对外时可改 0.0.0.0（容器内必须是 0.0.0.0）。
HOST=127.0.0.1

# ---- 房间容量（读取位置：packages/server/src/main.ts，默认取 @ac/shared 的 LIMITS）----
MAX_ROOMS=64
MAX_PLAYERS_PER_ROOM=4

# ---- 模拟调度（ADR-004 §3：只影响服务器调度，不改模拟步长）----
# 服务器 tick 步长，单位毫秒。模拟内核只接受 50ms；改这里不会改模拟常量（SERVER_TICK_MS=50）。
TICK_MS=50

# ---- 持久化（读取位置：packages/server/src/main.ts → packages/server/src/match/store.ts）----
# 对战记录 matches.ndjson 与单场诊断报告 reports/ 的落盘目录；删除该目录即重置本地战绩。
DATA_DIR=./data

# ---- 日志（读取位置：P10 交付物 packages/server/src/log.ts）----
# 结构化 JSON 行日志级别：debug | info | warn | error；默认 info。
LOG_LEVEL=info

# ---- 来源校验（读取位置：P10 交付物 packages/server/src/security.ts）----
# WebSocket 来源白名单，逗号分隔；* 表示不校验（仅限本机开发）。
# 反代上线示例：ALLOWED_ORIGINS=https://game.example.com
ALLOWED_ORIGINS=http://localhost:5173
