# 复制为 .env 后按需修改；仓库不提交任何真实密钥（本项目目前没有密钥）。
# 端口与监听地址（ADR-004：单进程同时承载 HTTP 与 WebSocket）
PORT=8787
# 注意：8080 常被本机其它软件（如 Cursor 的内置服务）占用；冲突时改这里，或临时 PORT=9000。
HOST=127.0.0.1

# 房间容量上限（P03 使用）
MAX_ROOMS=64
MAX_PLAYERS_PER_ROOM=4

# 服务器模拟步长，单位毫秒。必须与 @ac/shared 的 SERVER_TICK_MS 一致（见 P02 §5.5）
TICK_MS=50

# 数据目录：对战记录与诊断报告落盘位置（P08/P10 使用）
DATA_DIR=./data

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# WebSocket 来源白名单，逗号分隔；* 表示不校验（仅限本机开发）
ALLOWED_ORIGINS=http://localhost:5173
